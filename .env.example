# ---------------------------------------------------------------------
# Base de dados (Supabase)
# Usa a ligação do POOLER em modo transacao (porta 6543) em producao.
# Supabase > Project Settings > Database > Connection string > URI
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Segredo para assinar cookies de sessao. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Codigo que protege o /comecar (criacao da primeira conta de dona).
# Depois de existir uma dona, o /comecar deixa de existir.
SETUP_CODE=""

# O suporte nao vive na base de dados: e esta lista.
# Telefones separados por virgula. Quem entrar com um destes ve tudo.
SUPPORT_PHONES="+351900000000"

# Endereco publico do site (usado nos links do WhatsApp e no e-mail).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
