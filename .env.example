# ---------------------------------------------------------------------
# Base de dados (Supabase)
# Usa a ligação do POOLER em modo transacao (porta 6543) em producao.
# Supabase > Project Settings > Database > Connection string > URI
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Segredo para assinar cookies de sessao. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Codigo que protege o /comecar (criacao da primeira conta de dona).
# Depois de existir uma dona, o /comecar deixa de existir.
SETUP_CODE=""

# Endereco publico do site. E a raiz de tudo o que sai daqui para fora:
# os links do WhatsApp, o robots.txt, o sitemap.xml e a imagem que
# aparece quando alguem cola um link numa conversa. Sem barra no fim.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Que casa e esta: o nome de uma pasta em instalacoes/. Vazio e a Nohora.
# Para a casa de demonstracao, "demo". Entra no build (o logotipo, as
# fotografias, o cartao do link): muda-la obriga a construir de novo.
NEXT_PUBLIC_INSTALACAO=""

# So para a casa de demonstracao: a palavra-passe da equipa inventada,
# a mesma para todas, posta pelo `npm run semear`. Sem ela, o semear
# sorteia uma e mostra-a no fim, uma vez.
# DEMO_SENHA=""
